<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CardSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundColor="#F6F2E8"
    BackgroundImageSource="startbg2.png">

    <Grid BackgroundColor="#99000000">
        <Grid Padding="24,10,24,18"
              RowDefinitions="Auto,*"
              RowSpacing="8">
        <controls:FantasyButton Text="Back"
                                Clicked="OnBackClicked"
                                ButtonImage="ui_button_red_dark.png"
                                ButtonWidth="116"
                                ButtonHeight="38"
                                LabelFontSize="13"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0"
                                ZIndex="2" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding MainCards}"
                        SelectionMode="None"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        MaximumWidthRequest="940">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3"
                                 HorizontalItemSpacing="18"
                                 VerticalItemSpacing="0" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="3"
                            Stroke="#FFE08A"
                            StrokeThickness="3"
                            BackgroundColor="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectHeroCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid HeightRequest="318"
                              WidthRequest="280">
                            <Border StrokeShape="RoundRectangle 13"
                                    StrokeThickness="0">
                                <Image Source="bg3.png"
                                       Aspect="AspectFill"
                                       Opacity="0.82" />
                            </Border>

                            <Grid RowDefinitions="*,Auto,Auto"
                                  Padding="12,12,12,14"
                                  RowSpacing="9">

                                <Image Source="{Binding Image}"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       MaximumHeightRequest="218" />

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,*,*"
                                      ColumnSpacing="8"
                                      Padding="2,0">
                                    <Border BackgroundColor="#99070510"
                                            Stroke="#66FFE08A"
                                            StrokeThickness="1"
                                            Padding="5,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Hp, StringFormat='HP {0}'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#FFE08A" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            BackgroundColor="#99070510"
                                            Stroke="#66FFE08A"
                                            StrokeThickness="1"
                                            Padding="5,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Atk, StringFormat='ATK {0}'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#FFE08A" />
                                    </Border>
                                    <Border Grid.Column="2"
                                            BackgroundColor="#99070510"
                                            Stroke="#66FFE08A"
                                            StrokeThickness="1"
                                            Padding="5,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Def, StringFormat='DEF {0}'}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="#FFE08A" />
                                    </Border>
                                </Grid>

                                <controls:FantasyButton Text="Select"
                                                        Grid.Row="2"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectHeroCommand}"
                                                        CommandParameter="{Binding .}"
                                                        ButtonImage="ui_button_blue_glow.png"
                                                        ButtonWidth="180"
                                                        ButtonHeight="46"
                                                        LabelFontSize="14"
                                                        HorizontalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
