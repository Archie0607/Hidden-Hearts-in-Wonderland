<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CardSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundColor="#F6F2E8"
    BackgroundImageSource="startbg2.png">

    <Grid BackgroundColor="#80000000">
        <Grid Padding="1"
              RowDefinitions="Auto,*"
              RowSpacing="16">
        <controls:FantasyButton Text="Back"
                                Clicked="OnBackClicked"
                                ButtonImage="ui_button_red_dark.png"
                                ButtonWidth="116"
                                ButtonHeight="38"
                                LabelFontSize="13"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,12,12,0"
                                ZIndex="2" />

        <VerticalStackLayout Spacing="4">
            <!--<Label Text="Choose your hero"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>-->
            <!--<Label Text="{Binding Message}"
                   FontSize="14"
                   TextColor="White" 
                   HorizontalOptions="Center"/>-->
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding MainCards}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="1"
                            Stroke="Gold"
                            StrokeThickness="3"
                            BackgroundColor="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectHeroCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid Margin="5" VerticalOptions="Start" HeightRequest="300">
                            <Border StrokeShape="RoundRectangle 15"
                                        StrokeThickness="0">
                                <Image Source="bg3.png" 
                                           Aspect="AspectFill" 
                                           Opacity="0.8" />
                            </Border>

                            <VerticalStackLayout Spacing="10" 
                                                 Padding="15">

                                <Image Source="{Binding Image}"
                                           Aspect="AspectFit"
                                           HeightRequest="120" />
                                <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="Gold" 
                                           HorizontalTextAlignment="Center" />

                                <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="Gold"
                                           HorizontalTextAlignment="Center" />

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                                    <Label Text="{Binding Hp, StringFormat='HP {0}'}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Gold" />
                                    <Label Grid.Column="1" Text="{Binding Atk, StringFormat='ATK {0}'}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Gold" />
                                    <Label Grid.Column="2" Text="{Binding Def, StringFormat='DEF {0}'}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="Gold" />
                                </Grid>

                                <controls:FantasyButton Text="Select"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectHeroCommand}"
                                                        CommandParameter="{Binding .}"
                                                        ButtonImage="ui_button_blue_glow.png"
                                                        ButtonWidth="180"
                                                        ButtonHeight="46"
                                                        LabelFontSize="14"
                                                        HorizontalOptions="Center"
                                                        Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
