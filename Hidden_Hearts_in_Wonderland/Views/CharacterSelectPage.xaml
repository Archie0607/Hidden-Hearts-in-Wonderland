<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CharacterSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#E3F2FD">

    <Grid>
        <VerticalStackLayout
            WidthRequest="520"
            Spacing="18"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <Label Text="Choose a character"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#333"
                   HorizontalOptions="Center" />

            <Border BackgroundColor="#FFF8E1"
                    Padding="12,8"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Label x:Name="CoinsLabel"
                       Text="Coins: 0"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#333" />
            </Border>

            <CollectionView ItemsSource="{Binding Characters}"
                            ItemsLayout="VerticalList"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10"
                                Padding="15"
                                BackgroundColor="#FFF8E1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="25" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#80000000"
                                        Offset="3,3"
                                        Radius="12" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="120,*"
                                  ColumnSpacing="15">
                                <Border>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15" />
                                    </Border.StrokeShape>

                                    <Image Source="{Binding Image}"
                                           Aspect="AspectFill"
                                           HeightRequest="120"
                                           WidthRequest="120" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="10">
                                    <Label Text="{Binding Name}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#333" />

                                    <Border BackgroundColor="#90CAF9"
                                            Padding="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="15" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCharacterCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Label Text="Select"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="Black"
                                               FontAttributes="Bold" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Play Slime Match"
                    Clicked="OnMatchGameClicked"
                    BackgroundColor="#FF80A0"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="22"
                    WidthRequest="240"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
