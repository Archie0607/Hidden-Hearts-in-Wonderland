<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CharacterSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundImageSource="startbg2.png">

    <Grid Padding="14,8">
        <controls:FantasyButton Text="Back"
                                Clicked="OnBackClicked"
                                ButtonImage="ui_button_red_dark.png"
                                ButtonWidth="116"
                                ButtonHeight="38"
                                LabelFontSize="13"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                ZIndex="2" />

        <VerticalStackLayout
            Spacing="8"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="860">
            
      

            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center">
                <controls:FantasyButton Text="Battle"
                                        Clicked="OnBattleClicked"
                                        ButtonImage="ui_button_red_normal.png"
                                        ButtonWidth="180"
                                        ButtonHeight="40"
                                        LabelFontSize="13" />

                <controls:FantasyButton Text="Play Slime Match"
                                        Clicked="OnMatchGameClicked"
                                        ButtonImage="ui_button_blue_normal.png"
                                        ButtonWidth="180"
                                        ButtonHeight="40"
                                        LabelFontSize="13" />

                <controls:FantasyButton Text="Shop"
                                        Clicked="OnShopClicked"
                                        ButtonImage="ui_button_green_normal.png"
                                        ButtonWidth="180"
                                        ButtonHeight="40"
                                        LabelFontSize="13" />

                <controls:FantasyButton Text="Bag"
                                        Clicked="OnBagClicked"
                                        ButtonImage="ui_button_purple_normal.png"
                                        ButtonWidth="180"
                                        ButtonHeight="40"
                                        LabelFontSize="13" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Characters}"
                            SelectionMode="None"
                            HeightRequest="218"
                            HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="1"
                                Stroke="Gold"
                                StrokeThickness="3"
                                BackgroundColor="Transparent"
                                HeightRequest="210"
                                WidthRequest="188">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#80000000"
                                        Offset="2,2"
                                        Radius="8" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCharacterCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid VerticalOptions="Start">
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <Image Source="bg4.png" 
                                           Aspect="AspectFill" 
                                           Opacity="0.8" />
                                </Border>

                                <Grid RowDefinitions="132,Auto,Auto" RowSpacing="6">
                                    <Border BackgroundColor="Transparent"
                                            HeightRequest="132"
                                            Stroke="Transparent"
                                            WidthRequest="168">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Image Source="{Binding Image}"
                                               Aspect="AspectFit"
                                               HeightRequest="126"
                                               WidthRequest="160"
                                               HorizontalOptions="Center"
                                               VerticalOptions="End" />
                                    </Border>


                                    <Label Grid.Row="1"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           HorizontalOptions="Center" />

                                    <Border Grid.Row="2"
                                            BackgroundColor="LightPink"
                                            Stroke="Gold"
                                            StrokeThickness="2"
                                            Padding="8,3"
                                            HorizontalOptions="Center"
                                            Margin="0,0,0,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>

                                        <Label Text="{Binding AffectionText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           HorizontalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
