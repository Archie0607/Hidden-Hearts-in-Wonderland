<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CharacterSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#E3F2FD">

    <Grid Padding="14,8">
        <VerticalStackLayout
            Spacing="8"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            MaximumWidthRequest="860">

            <Label Text="Choose a character"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#333"
                   HorizontalOptions="Center" />

            <Border BackgroundColor="#FFF8E1"
                    Padding="12,6"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Label x:Name="CoinsLabel"
                       Text="Coins: 0"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#333" />
            </Border>

            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center">
                <Button Text="Battle"
                        Clicked="OnBattleClicked"
                        BackgroundColor="#273043"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        WidthRequest="180"
                        HeightRequest="32"
                        FontSize="13" />

                <Button Text="Play Slime Match"
                        Clicked="OnMatchGameClicked"
                        BackgroundColor="#FF80A0"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        WidthRequest="180"
                        HeightRequest="32"
                        FontSize="13" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Characters}"
                            SelectionMode="None"
                            HeightRequest="218"
                            HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10"
                                BackgroundColor="#FFF8E1"
                                HeightRequest="210"
                                WidthRequest="188">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#80000000"
                                        Offset="2,2"
                                        Radius="8" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCharacterCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="132,Auto,Auto"
                                  RowSpacing="6">
                                <Border BackgroundColor="#F8FBFF"
                                        HeightRequest="132"
                                        WidthRequest="168">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Image Source="{Binding Image}"
                                           Aspect="AspectFit"
                                           HeightRequest="126"
                                           WidthRequest="160"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End" />
                                </Border>

                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#333"
                                       HorizontalOptions="Center" />

                                <Border Grid.Row="2"
                                        BackgroundColor="#E3F2FD"
                                        Padding="8,3"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Label Text="{Binding AffectionText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#455A64"
                                           HorizontalOptions="Center" />
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
