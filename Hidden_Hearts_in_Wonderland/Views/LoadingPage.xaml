<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hidden_Hearts_in_Wonderland.Views.LoadingPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="loading1.png">
    <Grid>
        <!--<Image Source="loading_bg.png"
               Aspect="AspectFill" />-->

        <Border Stroke="#FFD700" 
        StrokeThickness="2"
        VerticalOptions="End"
        Margin="80,0,80,25"
        Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="4" />
            </Border.StrokeShape>

            <ProgressBar x:Name="LoadingProgressBar"
                 Progress="0"
                 ProgressColor="MediumVioletRed" />
        </Border>
    </Grid>
</ContentPage>
