<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.MatchGamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundColor="#F7FBFF"
    BackgroundImageSource="startbg2.png">

    <Grid>
        <Grid x:Name="RootGrid"
              RowDefinitions="Auto,*"
              ColumnDefinitions="Auto,*,Auto"
              Padding="4,2"
              RowSpacing="3"
              ColumnSpacing="4"
              SizeChanged="OnPageSizeChanged">

            <Grid x:Name="TopHud"
              Grid.ColumnSpan="3"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
              ColumnSpacing="5">
            <Label Text="Slime Match"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#253047"
                   VerticalOptions="Center" />

            <controls:FantasyButton Grid.Column="1"
                                    Text="Restart"
                                    Command="{Binding RestartCommand}"
                                    ButtonImage="ui_button_blue_normal.png"
                                    ButtonWidth="84"
                                    ButtonHeight="24"
                                    LabelFontSize="9" />

            <controls:FantasyButton Grid.Column="2"
                                    Text="Back"
                                    Command="{Binding BackCommand}"
                                    ButtonImage="ui_button_red_dark.png"
                                    ButtonWidth="84"
                                    ButtonHeight="24"
                                    LabelFontSize="9" />

            <Label Text="{Binding StatusText}"
                   Grid.Column="3"
                   FontSize="10"
                   TextColor="#596273"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />

            <Border Grid.Column="4"
                    BackgroundColor="#EAF5FF"
                    Padding="6,2"
                    Stroke="#B8D9F4"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="Goal"
                           FontSize="9"
                           TextColor="#596273"
                           VerticalOptions="Center" />
                    <Label Text="{Binding GoalText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#253047"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="5"
                    BackgroundColor="#FFF8E8"
                    Padding="6,2"
                    Stroke="#F2D99A"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="Moves"
                           FontSize="9"
                           TextColor="#756234"
                           VerticalOptions="Center" />
                    <Label Text="{Binding MovesLeft}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#443716"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="6"
                    BackgroundColor="#FFEFF6"
                    Padding="6,2"
                    Stroke="#F4BDD4"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="Score"
                           FontSize="9"
                           TextColor="#785169"
                           VerticalOptions="Center" />
                    <Label Text="{Binding Score}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#4C263A"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="7"
                    BackgroundColor="#F1FFF0"
                    Padding="6,2"
                    Stroke="#BFE5B8"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="4">
                    <Label Text="Coins"
                           FontSize="9"
                           TextColor="#4F704A"
                           VerticalOptions="Center" />
                    <Label Text="{Binding CoinText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#31552D"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Border x:Name="LeftHud"
                Grid.Row="1"
                Grid.Column="0"
                WidthRequest="92"
                Padding="6"
                BackgroundColor="#80000000"
                Stroke="Gold"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6"
                                 VerticalOptions="Center">
                <Label Text="Slime Match"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <controls:FantasyButton Text="Restart"
                                        Command="{Binding RestartCommand}"
                                        ButtonImage="ui_button_blue_normal.png"
                                        ButtonWidth="78"
                                        ButtonHeight="26"
                                        LabelFontSize="9"
                                        HorizontalOptions="Center" />
                <controls:FantasyButton Text="Back"
                                        Command="{Binding BackCommand}"
                                        ButtonImage="ui_button_red_dark.png"
                                        ButtonWidth="78"
                                        ButtonHeight="26"
                                        LabelFontSize="9"
                                        HorizontalOptions="Center" />
                <Border BackgroundColor="#80000000"
                        Padding="4,3"
                        Stroke="Gold"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Score"
                               FontSize="9"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Score}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="#80000000"
                        Padding="4,3"
                        Stroke="Gold"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Coins"
                               FontSize="9"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding CoinText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Border>

        <Border x:Name="BoardBorder"
                Grid.Row="1"
                Grid.Column="1"
                Padding="3"
                BackgroundColor="#80000000"
                Stroke="Gold"
                StrokeThickness="2"
                SizeChanged="OnBoardSizeChanged">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid x:Name="BoardGrid"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
        </Border>

        <Border x:Name="RightHud"
                Grid.Row="1"
                Grid.Column="2"
                WidthRequest="92"
                Padding="6"
                BackgroundColor="#80000000"
                Stroke="Gold"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6"
                                 VerticalOptions="Center">
                <Border BackgroundColor="#80000000"
                        Padding="4,3"
                        Stroke="Gold"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Goal"
                               FontSize="9"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding GoalText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="#80000000"
                        Padding="4,3"
                        Stroke="Gold"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Moves"
                               FontSize="9"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding MovesLeft}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding StatusText}"
                       FontSize="10"
                       TextColor="White"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
        </Grid>

        <Grid BackgroundColor="#B3000000"
              IsVisible="{Binding IsResultPopupVisible}">
            <Border BackgroundColor="#80000000"
                    Stroke="#FFD866"
                    StrokeThickness="2"
                    Padding="20"
                    WidthRequest="340"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding ResultTitle}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFD866"
                           HorizontalTextAlignment="Center" />
                    <HorizontalStackLayout Spacing="7"
                                           HorizontalOptions="Center">
                        <Image Source="coin.png"
                               WidthRequest="24"
                               HeightRequest="24"
                               Aspect="AspectFit" />
                        <Label Text="{Binding ResultCoinsText}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#92E27F"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding ResultScoreText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ResultCollectedText}"
                           FontSize="15"
                           TextColor="#DDE4FF"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ResultBonusText}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#D9B6FF"
                           HorizontalTextAlignment="Center" />
                    <controls:FantasyButton Text="Continue"
                                            Command="{Binding ContinueResultCommand}"
                                            ButtonImage="ui_button_green_glow.png"
                                            ButtonHeight="42"
                                            LabelFontSize="13"
                                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
