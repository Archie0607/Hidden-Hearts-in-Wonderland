<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.ShopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundColor="#F4F7FB"
    BackgroundImageSource="shopbg.png">

    <Grid>

        <Grid Padding="18"
              RowDefinitions="Auto,*"
              RowSpacing="14">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <VerticalStackLayout Spacing="4">
                    <!--<Label Text="Shop"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White" />-->
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="coin.png"
                               WidthRequest="30"
                               HeightRequest="30"
                               Aspect="AspectFit" />
                        <Label Text="{Binding CoinsText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <controls:FantasyButton Grid.Column="1"
                                        Text="Back"
                                        Command="{Binding BackCommand}"
                                        ButtonImage="ui_button_red_dark.png"
                                        ButtonWidth="116"
                                        ButtonHeight="38"
                                        LabelFontSize="13" />
            </Grid>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="2"
                                     HorizontalItemSpacing="12"
                                     VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                BackgroundColor="#80000000"
                                Stroke="Gold"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="94,Auto,Auto,Auto"
                                  RowSpacing="7">
                                <Image Source="{Binding Image}"
                                       Aspect="AspectFit"
                                       HeightRequest="92" />
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center" />
                                <Label Grid.Row="2"
                                       Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                <Grid Grid.Row="3"
                                      ColumnDefinitions="*,Auto,*"
                                      ColumnSpacing="8"
                                      HorizontalOptions="Center">
                                    <controls:FantasyButton Grid.ColumnSpan="3"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.BuyCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ButtonImage="ui_button_green_glow.png"
                                                            ButtonWidth="160"
                                                            ButtonHeight="42"
                                                            LabelFontSize="13" />
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="4"
                                                           VerticalOptions="Center"
                                                           InputTransparent="True">
                                        <Image Source="coin.png"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding Price}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid BackgroundColor="#B3000000" 
              IsVisible="{Binding IsShowPopup}">
            <Border BackgroundColor="#80000000"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="300"
                    Stroke="Gold"
                    StrokeThickness="2"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Image Source="{Binding PopupImage}" 
                           HeightRequest="60" 
                           Aspect="AspectFit"/>

                    <Label Text="Shop" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="Gold"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding PopupMessage}" 
                           FontSize="14" 
                           TextColor="White"
                           HorizontalTextAlignment="Center" />

                    <Button Text="OK" 
                            Command="{Binding ClosePopupCommand}"
                            BackgroundColor="Gold"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="40"
                            WidthRequest="120"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
