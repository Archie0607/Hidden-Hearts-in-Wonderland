<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CardStageSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#EEF3F0">

    <Grid Padding="18"
          RowDefinitions="Auto,*"
          RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="10">
            <VerticalStackLayout Spacing="4">
                <Label Text="Battle stages"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#253047" />
                <Label Text="{Binding Message}"
                       FontSize="13"
                       TextColor="#596273" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Team"
                    Command="{Binding TeamCommand}"
                    BackgroundColor="#E4F5E9"
                    TextColor="#253047"
                    CornerRadius="10"
                    HeightRequest="38" />
            <Button Grid.Column="2"
                    Text="Back"
                    Command="{Binding BackCommand}"
                    BackgroundColor="#FFE2E7"
                    TextColor="#253047"
                    CornerRadius="10"
                    HeightRequest="38" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Stages}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14"
                            BackgroundColor="#FFFFFF"
                            Stroke="#D6DCE8"
                            StrokeThickness="2"
                            Opacity="{Binding Opacity}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectStageCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#253047" />
                            <Label Text="{Binding EnemyText}"
                                   FontSize="13"
                                   TextColor="#596273"
                                   LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding LockText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#31552D"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Play"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectStageCommand}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding IsUnlocked}"
                                        BackgroundColor="#253047"
                                        TextColor="White"
                                        CornerRadius="10"
                                        HeightRequest="34" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
