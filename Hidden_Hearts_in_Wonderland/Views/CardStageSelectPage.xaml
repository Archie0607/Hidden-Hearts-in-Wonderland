<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.CardStageSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundColor="#151827"
    BackgroundImageSource="bgbattle.png">

    <Grid BackgroundColor="#80000000">
        <Grid Padding="18"
              RowDefinitions="Auto,*"
              RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="10">
            <VerticalStackLayout Spacing="4">
                <Label Text="Battle stages"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF" />
                <Label Text="{Binding Message}"
                       FontSize="13"
                       TextColor="#E8EAF5" />
            </VerticalStackLayout>
            <controls:FantasyButton Grid.Column="1"
                                    Text="Team"
                                    Command="{Binding TeamCommand}"
                                    ButtonImage="ui_button_green_normal.png"
                                    ButtonWidth="116"
                                    ButtonHeight="38"
                                    LabelFontSize="13" />
            <controls:FantasyButton Grid.Column="2"
                                    Text="Stats"
                                    Command="{Binding StatsCommand}"
                                    ButtonImage="ui_button_purple_normal.png"
                                    ButtonWidth="116"
                                    ButtonHeight="38"
                                    LabelFontSize="13" />
            <controls:FantasyButton Grid.Column="3"
                                    Text="Back"
                                    Command="{Binding BackCommand}"
                                    ButtonImage="ui_button_red_dark.png"
                                    ButtonWidth="116"
                                    ButtonHeight="38"
                                    LabelFontSize="13" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Stages}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14"
                            BackgroundColor="#D91B2033"
                            Stroke="#FFD866"
                            StrokeThickness="2"
                            Opacity="{Binding Opacity}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectStageCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Label Text="{Binding EnemyText}"
                                   FontSize="13"
                                   TextColor="#DDE4FF"
                                   LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding LockText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#92E27F"
                                       VerticalOptions="Center" />
                                <controls:FantasyButton Grid.Column="1"
                                                        Text="Play"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectStageCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding IsUnlocked}"
                                                        ButtonImage="ui_button_blue_normal.png"
                                                        ButtonWidth="112"
                                                        ButtonHeight="38"
                                                        LabelFontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
