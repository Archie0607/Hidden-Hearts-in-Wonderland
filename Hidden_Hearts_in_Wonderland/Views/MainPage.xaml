<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Hidden_Hearts_in_Wonderland.Views.Controls"
    BackgroundImageSource="startbg2.png"
    BackgroundColor="#E3F2FD">

    <Grid>
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="20">

            <controls:FantasyButton Text="Start Game"
                                    ButtonImage="ui_button_blue_glow.png"
                                    ButtonWidth="300"
                                    ButtonHeight="86"
                                    Clicked="OnStartClicked" />

            <controls:FantasyButton Text="Settings"
                                    ButtonImage="ui_button_purple_normal.png"
                                    ButtonWidth="300"
                                    ButtonHeight="86"
                                    Clicked="OnSettingsClicked" />

        </VerticalStackLayout>

        <Grid x:Name="SettingsOverlay"
              IsVisible="False">
            <BoxView BackgroundColor="#66000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Stroke="#FFE08A"
                    StrokeThickness="2"
                    Padding="20"
                    WidthRequest="390"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#F2070612"
                                      Offset="0" />
                        <GradientStop Color="#EE140A24"
                                      Offset="0.58" />
                        <GradientStop Color="#F009050D"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>

                <ScrollView MaximumHeightRequest="540">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="40,*,40"
                          ColumnSpacing="8">
                        <BoxView HeightRequest="1"
                                 VerticalOptions="Center"
                                 Color="#80FFD866" />
                        <Label Grid.Column="1"
                               Text="Settings"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#FFD866"
                               HorizontalTextAlignment="Center" />
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 VerticalOptions="Center"
                                 Color="#80FFD866" />
                    </Grid>

                    <Border BackgroundColor="#66140B24"
                            Stroke="#33FFD866"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Main Sound"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label x:Name="MainVolumeLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#A8F78D" />
                            </Grid>
                            <HorizontalStackLayout x:Name="MainVolumeDots"
                                                   Grid.Row="1"
                                                   Spacing="7"
                                                   HorizontalOptions="Center" />
                            <Label Grid.Row="2"
                                   Text="Main menu and slime minigame music"
                                   FontSize="11"
                                   TextColor="#DDE4FF" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#66140B24"
                            Stroke="#33FFD866"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Battle Sound"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label x:Name="BattleVolumeLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#A8F78D" />
                            </Grid>
                            <HorizontalStackLayout x:Name="BattleVolumeDots"
                                                   Grid.Row="1"
                                                   Spacing="7"
                                                   HorizontalOptions="Center" />
                            <Label Grid.Row="2"
                                   Text="Battle music"
                                   FontSize="11"
                                   TextColor="#DDE4FF" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#66140B24"
                            Stroke="#33FFD866"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Click Sound"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label x:Name="ClickVolumeLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#A8F78D" />
                            </Grid>
                            <HorizontalStackLayout x:Name="ClickVolumeDots"
                                                   Grid.Row="1"
                                                   Spacing="7"
                                                   HorizontalOptions="Center" />
                            <Label Grid.Row="2"
                                   Text="Button clicks"
                                   FontSize="11"
                                   TextColor="#DDE4FF" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#66140B24"
                            Stroke="#33FFD866"
                            StrokeThickness="1"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Win / Game Over"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label x:Name="ResultVolumeLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#A8F78D" />
                            </Grid>
                            <HorizontalStackLayout x:Name="ResultVolumeDots"
                                                   Grid.Row="1"
                                                   Spacing="7"
                                                   HorizontalOptions="Center" />
                            <Label Grid.Row="2"
                                   Text="Win and game over effects"
                                   FontSize="11"
                                   TextColor="#DDE4FF" />
                        </Grid>
                    </Border>

                    <controls:FantasyButton Text="Close"
                                            ButtonImage="ui_button_red_dark.png"
                                            ButtonWidth="190"
                                            ButtonHeight="48"
                                            LabelFontSize="14"
                                            HorizontalOptions="Center"
                                            Clicked="OnCloseSettingsClicked" />
                </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
