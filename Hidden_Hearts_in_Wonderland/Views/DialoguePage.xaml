<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.DialoguePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="Black"
    Padding="0">

    <Grid RowDefinitions="*,Auto,Auto">
        <Image Source="bg1.jpg"
               Grid.RowSpan="3"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Button Text="กลับ"
                Clicked="OnBackClicked"
                Margin="16,16,0,0"
                Padding="14,8"
                BackgroundColor="#CCFFF8E1"
                TextColor="#333"
                FontAttributes="Bold"
                CornerRadius="16"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                ZIndex="10" />

        <Image Source="{Binding CurrentNode.Image}"
               Grid.Row="0"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="0,24,0,8"
               MaximumHeightRequest="420" />

        <VerticalStackLayout Grid.Row="1"
                             BindableLayout.ItemsSource="{Binding CurrentNode.Choices}"
                             Margin="20,0,20,8"
                             Spacing="8"
                             HorizontalOptions="Fill">

            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            BackgroundColor="#EE90CAF9">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectChoiceCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Label Text="{Binding Text}"
                               FontSize="15"
                               LineBreakMode="WordWrap"
                               TextColor="Black" />
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Border Grid.Row="2"
                Margin="20,0,20,20"
                Padding="14"
                BackgroundColor="#D9FFC0CB"
                StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Border BackgroundColor="#FF80A0"
                        Padding="6,4"
                        HorizontalOptions="Start">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>

                    <Label Text="{Binding CurrentNode.CharacterName}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White" />
                </Border>

                <Label Text="{Binding CurrentNode.Text}"
                       FontSize="17"
                       LineBreakMode="WordWrap"
                       TextColor="White" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
