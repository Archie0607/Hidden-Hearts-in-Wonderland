<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Hidden_Hearts_in_Wonderland.Views.DialoguePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="Black"
    Padding="0">

    <Grid RowDefinitions="*,Auto"
          ColumnDefinitions="0.48*,0.52*">

        <Image Source="bg1.jpg"
               Grid.RowSpan="2"
               Grid.ColumnSpan="2"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Button Text="กลับ"
                Clicked="OnBackClicked"
                Margin="16,16,0,0"
                Padding="14,8"
                BackgroundColor="#CCFFF8E1"
                TextColor="#333"
                FontAttributes="Bold"
                CornerRadius="16"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                ZIndex="10" />

        <Image Source="{Binding CurrentNode.Image}"
               Grid.Row="0"
               Grid.Column="0"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Margin="28,48,12,8"
               MaximumHeightRequest="560"
               MaximumWidthRequest="420" />

        <ScrollView Grid.Row="0"
                    Grid.Column="1"
                    Margin="12,72,28,12"
                    VerticalOptions="Center">

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentNode.Choices}"
                                 Spacing="12"
                                 HorizontalOptions="Fill">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                BackgroundColor="#EE90CAF9">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectChoiceCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Label Text="{Binding Text}"
                                   FontSize="17"
                                   LineBreakMode="WordWrap"
                                   TextColor="Black" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="24,0,24,20"
                Padding="16"
                BackgroundColor="#D9FFC0CB"
                StrokeThickness="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <Border BackgroundColor="#FF80A0"
                        Padding="8,5"
                        HorizontalOptions="Start">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>

                    <Label Text="{Binding CurrentNode.CharacterName}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White" />
                </Border>

                <Label Text="{Binding CurrentNode.Text}"
                       FontSize="18"
                       LineBreakMode="WordWrap"
                       TextColor="White" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
